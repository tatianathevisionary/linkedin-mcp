{
  "name": "linkedin-mcp",
  "version": "1.0.0",
  "description": "MCP server for authenticated LinkedIn search, profile, and people lookup via Voyager API",
  "type": "module",
  "bin": {
    "linkedin-mcp": "./src/server.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "linkedin:search": "tsx src/clients/linkedin/search-jobs.ts",
    "linkedin:companies": "tsx src/clients/linkedin/search-companies.ts",
    "linkedin:profile": "tsx src/clients/linkedin/fetch-profile.ts",
    "linkedin:people": "tsx src/clients/linkedin/search-people.ts",
    "linkedin:person": "tsx src/clients/linkedin/fetch-person.ts",
    "linkedin:job": "tsx src/clients/linkedin/fetch-job.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "keytar": "^7.9.0",
    "sqlite3": "^5.1.7",
    "tough-cookie": "^4.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tough-cookie": "^4.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
