# LinkedIn MCP · environment variables
#
# Production deployments (FastMCP Cloud, Docker, etc.) MUST set these.
# Local development on macOS can leave them blank — the server falls back to
# reading Chrome cookies via Keychain (pycookiecheat).
#
# How to get these values:
# 1. Log into LinkedIn in Chrome
# 2. Open DevTools → Application → Cookies → https://www.linkedin.com
# 3. Copy the values of `li_at` and `JSESSIONID`
# 4. Note: JSESSIONID is wrapped in quotes in the cookie store — keep them as-is
#         in this env var (the server strips them when needed)
# 5. These cookies expire every 12 months. Rotate when LinkedIn logs you out.

LINKEDIN_LI_AT_COOKIE=
LINKEDIN_JSESSIONID=

# Optional · default LinkedIn cookie domain (rarely needs override)
# LINKEDIN_COOKIE_DOMAIN=.linkedin.com

# Optional · request timeout in seconds (default 30)
# LINKEDIN_REQUEST_TIMEOUT=30

# Optional · custom User-Agent (default mimics Chrome on macOS)
# LINKEDIN_USER_AGENT=
