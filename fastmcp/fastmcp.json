{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.11",
    "project": "."
  },
  "deployment": {
    "transport": "http",
    "host": "0.0.0.0",
    "port": 8000,
    "path": "/mcp/",
    "log_level": "INFO",
    "env": {
      "LINKEDIN_LI_AT_COOKIE": "${LINKEDIN_LI_AT_COOKIE}",
      "LINKEDIN_JSESSIONID": "${LINKEDIN_JSESSIONID}"
    }
  }
}
